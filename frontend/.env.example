# Groq (https://console.groq.com/keys). Server-side only: read by the /api functions,
# never bundled into the browser. Put it in .env.local for `npm run dev`, and in the
# Vercel project's Environment Variables for deploys.
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq model
# GROQ_MODEL=openai/gpt-oss-120b
