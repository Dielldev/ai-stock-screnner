# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Project Settings -> API -> JWT Settings -> JWT Secret (the "legacy" HS256 secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Hugging Face Inference API token (https://huggingface.co/settings/tokens)
HF_API_KEY=your-huggingface-token
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# SEC EDGAR requires a descriptive User-Agent with a contact address
SEC_EDGAR_USER_AGENT=ai-portfolio-tracker you@example.com

# Optional overrides
# GROQ_MODEL=llama-3.3-70b-versatile
